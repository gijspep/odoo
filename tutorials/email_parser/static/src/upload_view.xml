<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t t-name="email_parser.UploadView">
        <div class="d-flex flex-column align-items-center p-5 gap-4">

            <div class="ep-drop-zone w-100 border border-2 rounded-3 p-5 text-center"
                 style="max-width: 600px; cursor: pointer;"
                 t-on-click="onZoneClick"
                 t-on-dragover="onDragOver"
                 t-on-dragleave="onDragLeave"
                 t-on-drop="onDrop">
                <p class="mb-1"><strong>Drop .msg files here</strong></p>
                <p class="text-muted mb-0">or click to select</p>
                <input type="file" accept=".msg" multiple="1" class="d-none"
                       t-ref="fileInput" t-on-change="onFileChange" />
            </div>

            <div class="w-100 d-flex flex-column gap-2" style="max-width: 600px;">
                <t t-foreach="state.jobs" t-as="job" t-key="job.id">
                    <div class="card">
                        <div class="card-body py-2">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <span class="fw-semibold text-truncate" t-out="job.filename" />
                                <span t-attf-class="badge flex-shrink-0 #{job.badgeCls}"
                                      t-out="job.status" />
                            </div>
                            <div t-if="job.jobRef"
                                 class="text-muted small mt-1 font-monospace"
                                 t-out="'Job: ' + job.jobRef" />
                            <div t-if="job.progress"
                                 class="d-flex align-items-center gap-2 mt-1">
                                <div class="spinner-border spinner-border-sm text-primary"
                                     role="status" />
                                <span class="text-muted small" t-out="job.progress" />
                            </div>
                            <a t-if="job.resultLink"
                               t-att-href="job.resultLink"
                               class="btn btn-sm btn-outline-primary mt-2">
                                View Result →
                            </a>
                        </div>
                    </div>
                </t>
            </div>

        </div>
    </t>
</templates>
