<odoo>
    <template id="estate_property_offers">
        <div t-if="property.property_offer_ids">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Offer Price</th>
                        <th>Partner</th>
                        <th>Date Deadline</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t
                        t-set="offers"
                        t-value="property.mapped('property_offer_ids')"
                    />
                    <tr t-foreach="offers" t-as="offer">
                        <td><span t-field="offer.price" /></td>
                        <td><span t-field="offer.partner_id" /></td>
                        <td><span t-field="offer.date_deadline" /></td>
                        <td><span t-field="offer.status" /></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div t-else="">
            <span>No offers received yet. :(</span>
        </div>
    </template>

    <template id="report_property_offers_document">
        <div style="page-break-inside: avoid;">
            <h1 t-if="not is_user_report">
                <strong>Salesperson: </strong>
                <span t-field="property.salesperson" />
            </h1>
            <h2>
                <span t-field="property.name" />
            </h2>
            <div>
                <strong>Expected Price: </strong>
                <span t-field="property.expected_price" />
            </div>
            <div>
                <strong>Status: </strong>
                <span t-field="property.state" />
            </div>
            <br />
            <t t-call="estate.estate_property_offers" />
        </div>
    </template>

    <template id="report_property_offers">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="property">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-call="estate.report_property_offers_document" />
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_user_properties">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="user">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <strong>Salesperson: </strong>
                            <span t-field="user.name" />
                        </h2>
                        <br />
                        <t
                            t-foreach="user.with_context(active_test=False).property_ids"
                            t-as="property"
                        >
                            <t t-set="is_user_report" t-value="True" />
                            <t
                                t-call="estate.report_property_offers_document"
                            />
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
