<!--
outside arch field:
the name="name" value is purely decorative for the settings
and can be whatever i want to set it, but for convention and ease of use
should be set to something easily understood so
estate_property.list in this case is a good value for it.

the name="model" refers to the _name attribute value of the class

inside the arch field:
the name="" refers to an attribute name of the model defined in name="model" outside arch -->
<odoo>
    <record id="estate_property_records_action" model="ir.actions.act_window">
        <field name="name">Records</field>
        <field name="res_model">estate_property</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="estate_property_view_search" />
        <field name="context">{'search_default_available': True}</field>
    </record>

    <record
        id="estate_property_action_view_list"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="estate_property_view_list" />
        <field name="act_window_id" ref="estate_property_records_action" />
    </record>

    <record
        id="estate_property_action_view_form"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="estate_property_view_form" />
        <field name="act_window_id" ref="estate_property_records_action" />
    </record>
</odoo>
