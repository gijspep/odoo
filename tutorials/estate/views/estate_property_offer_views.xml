<odoo>
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate_property_offer.list</field>
        <field name="model">estate_property_offer</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-success="status == 'accepted'" decoration-danger="status == 'refused'">
                <field name="property_type_id" string="Property Type" />
                <field name="price" string="Price" />
                <field name="partner_id" string="Partner" />
                <field name="validity" string="Validity (days)" />
                <field name="date_deadline" string="Deadline" />
                <button
                    name="action_reply_offer"
                    type="object"
                    string="Accept"
                    context="{'accept': True}"
                    invisible="status in ['accepted', 'refused']"
                    icon="fa-check"
                />
                <button
                    name="action_reply_offer"
                    type="object"
                    string="Reject"
                    context="{'accept': False}"
                    invisible="status in ['accepted', 'refused']"
                    icon="fa-times"
                />
                <field name="status" string="Status" />
            </list>
        </field>
    </record>
    <record id="estate_property_offer_view_by_type_action" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">estate_property_offer</field>
        <field name="view_mode">list</field>
        <field name="domain">[('property_id.is_available', '=', True), ('property_type_id', '=', active_id)]</field>
    </record>
</odoo>
