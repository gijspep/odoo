<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">

        <Layout display="{ controlPanel: {} }" className="'o_dashboard h-100'">
             <t t-set-slot="control-panel-create-button">
                <button
                    t-on-click="showCustomers"
                    type="button"
                    class="btn btn-primary"
                >Customers</button>
                <button
                    t-on-click="showLeads"
                    type="button"
                    class="btn btn-primary"
                >Leads</button>
            </t>

            <DashboardItem
                title="'Average amount of t-shirt by order this month'"
                size="1"
            >
                <t t-set-slot="object">
                   <t t-esc="result.average_quantity" />
                </t>
            </DashboardItem>

            <DashboardItem
                title='"Average time for an order to go from &apos;new&apos; to &apos;sent&apos; or &apos;cancelled&apos;"'
                size="1"
            >
                <t t-set-slot="object">
                   <t t-esc="result.average_time" />
                </t>
            </DashboardItem>

            <DashboardItem title="'Number of new orders this month'" size="1">
                <t t-set-slot="object">
                   <t t-esc="result.nb_new_orders" />
                </t>
            </DashboardItem>

            <DashboardItem
                title="'Number of cancelled orders this month'"
                size="1"
            >
                <t t-set-slot="object">
                   <t t-esc="result.nb_cancelled_orders" />
                </t>
            </DashboardItem>

            <DashboardItem title="'Total amount of orders this month'" size="1">
                <t t-set-slot="object">
                   <t t-esc="result.total_amount" />
                </t>
            </DashboardItem>

            <DashboardItem title="'Shirt order by size'" size="2">
                <t t-set-slot="object">
                   <PieChart data="result.orders_by_size" />
                </t>
            </DashboardItem>



        </Layout>
    </t>

</templates>
